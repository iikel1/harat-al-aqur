---
const base = import.meta.env.BASE_URL;
const target = `${base}ar/`;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    {/* Instant, no history entry. The meta refresh is the no-JS fallback. */}
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
  </head>
  <body>
    <a href={target}>حارة العقر — Harat Al Aqur</a>
  </body>
</html>
