---
/**
 * The Al Aqur mark — the quarter's own wall, not a drawn symbol.
 *
 * The circuit is traced from Dr Al Salmi's plan by `work/trace_wall_plan.py`
 * (see `content/data/wall-plan.json`), reduced from 160 vertices to 25, and
 * normalised into a 0–100 box. It is drawn as FOUR OPEN RUNS rather than one
 * closed ring, because that is what the wall is: four stretches of wall
 * between the four *sabah*, which the book calls its only openings. The gaps
 * are the gates.
 *
 * The geometry is frozen here on purpose. It is *derived* from the plan, not
 * re-read from it at build time — a logo must not change shape because a
 * tracing threshold moved. If the trace is ever redone and the circuit
 * genuinely changes, regenerate these four paths deliberately.
 *
 * Floor is 16px. Below that the gate gaps close and the mark reads as a plain
 * ring, which loses the whole idea.
 *
 * Colour comes from `currentColor`, so set `color` on a wrapper to paint it.
 */
interface Props {
  /** Rendered size in px, square. Do not go below 16. */
  size?: number;
  /** Accessible name. Omit for decorative use — it is then hidden from AT. */
  title?: string;
  class?: string;
}

const { size = 28, title, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="-7 -7 114 114"
  fill="none"
  stroke="currentColor"
  stroke-width="5.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  {/* صباح الشجبي → صباح أبي المؤثر : the long west and south run */}
  <path
    d="M8.32 49.61 L8.06 50.70 L19.86 73.47 L35.42 69.44 L41.25 77.36 L39.45 82.36 L66.25 81.66 L67.07 95.14 L71.94 94.73 L77.36 100.00 L80.42 96.25 L81.27 96.27"
  />
  {/* صباح أبي المؤثر → صباح الصبخة : the short south-east stub between two close gates */}
  <path d="M90.89 97.54 L91.72 88.77" />
  {/* صباح الصبخة → صباح السوق : the east run */}
  <path
    d="M92.94 76.03 L93.04 75.00 L85.54 63.61 L88.61 62.63 L85.97 43.06 L79.03 18.75 L66.55 16.84"
  />
  {/* صباح السوق → صباح الشجبي : the north run, past the fort */}
  <path
    d="M60.70 8.19 L60.55 7.09 L49.99 0.00 L18.19 5.56 L17.78 12.23 L6.67 11.67 L6.80 39.56"
  />
</svg>
