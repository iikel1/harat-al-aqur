---
import { ui, type Lang } from '../lib/i18n';
import type { SourceNote } from '../lib/notes';

interface Props { note: SourceNote; lang: Lang }
const { note, lang } = Astro.props;
const t = ui[lang];
const body = note[lang];

// Two registers: 'dispute' = sources give different figures and the page shows
// all of them; 'unverified' = the book is the only voice. Never resolve either
// silently in the running text.
const label =
  note.kind === 'dispute'
    ? t.sourceNoteTitle
    : lang === 'ar'
      ? 'مصدر واحد فقط'
      : 'A single source';
---
<aside class={`note note--${note.kind}`} aria-label={label}>
  <p class="label">{label}</p>
  <p class="heading">{body.heading}</p>
  <p class="body">{body.body}</p>
</aside>

<style>
  .note {
    background: var(--surface-sunk);
    border: 1px solid var(--rule);
    border-inline-start: 3px solid var(--ink-faint);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
    margin-block: 2rem;
    max-width: var(--measure);
    font-family: var(--sans);
  }
  .note--dispute { border-inline-start-color: var(--clay); }
  .label {
    font-size: .7rem; letter-spacing: .14em; color: var(--ink-muted);
    margin-block-end: .5rem;
  }
  [dir='ltr'] .label { text-transform: uppercase; }
  .heading { font-family: var(--display); font-size: 1.1rem; font-weight: 700; margin-block-end: .35rem; }
  .body { font-size: .9rem; line-height: 1.85; color: var(--ink-muted); }
</style>
