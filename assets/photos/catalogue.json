    "full_bleed": false,
    "page_captions": [
      "مترين ويزيد من متانته قاعدة صخرية، ويتراوح ارتفاعه من خمسة إلى ستة أمتار ويحتوي السور على العديد من الأبراج المتصلة به وقيل يبلغ عددها خمسة عشر برجاً وتبلغ المسافة بين كل برجين (150 ـ )200 متر، ولكل برج من هذه الأبراج تسمية يعرف بها مثل برج المذبحة ويقع في الزاوية الشمالية على جانب الغربي من السور، وبرج ميرزة على الجانب الجنوبي من مسجد الشجبي ويسميه البعض برج بستان قسام، وبرج بلج على الجانب الشرقي على جهة الغرب من سوق نزوى، وبرج العلياء وهو الواقع أعلى من برج بلج، وبرج غوير يقع في السوق أمام بوابة السوق الشرقي المعروف باسم الصنصرة وكان السور متصلاً مع  صباح أبي المؤثر",
      "صباح أبي المؤثر"
    ]
  },
