# Cloudflare Pages headers. Netlify reads netlify.toml instead — the two files
# say the same thing and are kept in step by hand.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Astro hashes these filenames, so they can never go stale. The book's
# photographs live here too now, as WebP and JPEG variants named by content
# hash — which is what lets them be cached forever rather than for a week.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Subset faces from work/fetch_fonts.py. The filenames are not hashed, but they
# only change when that script is re-run against an upstream font revision.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# There is no /fonts/fonts.css any more: the @font-face rules are bundled into
# the page's own stylesheet, which is hashed and covered by the rule above.
# Nor is there /photos/* — the photographs are served from /_astro/.
